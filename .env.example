# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Elternportal Configuration
# Generate a secure 32-character key with: openssl rand -hex 16
CREDENTIALS_ENCRYPTION_KEY=your-secret-key-32-chars-long!!

# Go Backend URL (for Elternportal Vertretungen)
# Local development: http://localhost:8000
# Production: https://your-go-backend.vercel.app
GO_BACKEND_URL=http://localhost:8000
